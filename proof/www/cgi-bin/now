#!/bin/sh
# Hit counter in /state, so a restic restore from R2 can be checked against a known value.
n=$(cat /state/counter 2>/dev/null || echo 0)
n=$((n + 1))
echo "$n" > /state/counter
echo "Content-Type: text/plain"
echo
echo "host: $(hostname)"
echo "utc:  $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "hits: $n"
