{
	# Loopback front for svc:chitin only. tailscale serve terminates TLS and forwards to 127.0.0.1:7490.
	# facto must NEVER sit behind this Caddy: its token is in the URL path (svc:facto proxies straight to 8877).
	admin off
	auto_https off
	default_bind 127.0.0.1
	persist_config off
}

http://:7490 {
	# Caddy itself.
	handle /healthz {
		respond "ok caddy" 200
	}

	# The socket-only daemons, pinged live by the healthz prober (each request dials the unix socket: op ping -> pong).
	handle /router/healthz {
		rewrite * /healthz/router
		reverse_proxy 127.0.0.1:7489
	}
	handle /notify-sink/healthz {
		rewrite * /healthz/notify-sink
		reverse_proxy 127.0.0.1:7489
	}

	# chitin-approve (/healthz bare and under /approve). Same block as phobos's basis /approve (darwin#82):
	# `route` keeps strip_prefix ahead of anything sorted earlier; exactly one X-Forwarded-For (tailscale serve's caller);
	# Proto https because serve terminated TLS.
	@approve path /approve /approve/*
	handle @approve {
		route {
			uri strip_prefix /approve
			reverse_proxy 127.0.0.1:7481 {
				header_up X-Forwarded-For {header.X-Forwarded-For}
				header_up X-Forwarded-Proto https
				lb_try_duration 30s
				lb_try_interval 250ms
			}
		}
	}

	handle {
		respond "svc:chitin: /healthz /router/healthz /notify-sink/healthz /approve/healthz" 404
	}
}
